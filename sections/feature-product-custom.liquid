{% comment %}
  CHT MINI — Featured Products Section
  File: sections/cht-featured-products.liquid
{% endcomment %}

{% style %}
/* ============================================================
   CHT Featured Products — Styles
   ============================================================ */

.cht-fp *,
.cht-fp *::before,
.cht-fp *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

/* ── Section wrapper ── */
.cht-fp {
  --fp-accent:          {{ section.settings.accent_color }};
  --fp-bg:              {{ section.settings.section_bg }};
  --fp-title-color:     {{ section.settings.section_title_color }};
  --fp-card-bg:         {{ section.settings.card_bg }};
  --fp-card-radius:     {{ section.settings.card_radius }}px;
  --fp-product-title:   {{ section.settings.product_title_color }};
  --fp-meta-color:      {{ section.settings.meta_color }};
  --fp-price-color:     {{ section.settings.price_color }};
  --fp-badge-bg:        {{ section.settings.badge_bg }};
  --fp-badge-color:     {{ section.settings.badge_text_color }};
  --fp-btn-bg:          {{ section.settings.btn_bg }};
  --fp-btn-color:       {{ section.settings.btn_text_color }};
  --fp-btn-hover-bg:    {{ section.settings.btn_hover_bg }};
  --fp-star-color:      {{ section.settings.star_color }};
  --fp-viewall-color:   {{ section.settings.viewall_color }};
  --fp-heading-desktop: {{ section.settings.heading_size_desktop }}px;
  --fp-heading-mobile:  {{ section.settings.heading_size_mobile }}px;
  --fp-title-desktop:   {{ section.settings.product_title_size_desktop }}px;
  --fp-title-mobile:    {{ section.settings.product_title_size_mobile }}px;
  --fp-price-desktop:   {{ section.settings.price_size_desktop }}px;
  --fp-price-mobile:    {{ section.settings.price_size_mobile }}px;
  --fp-meta-desktop:    {{ section.settings.meta_size_desktop }}px;
  --fp-meta-mobile:     {{ section.settings.meta_size_mobile }}px;
  --fp-transition:      .28s cubic-bezier(.4,0,.2,1);

  background: var(--fp-bg);
  padding: {{ section.settings.section_padding_top }}px 0 {{ section.settings.section_padding_bottom }}px;
  width: 100%;
}

/* ── Inner container ── */
.cht-fp__inner {
  max-width: 1600px;
  margin: 0 auto;
  padding: 0 52px;
}

/* ── Section header ── */
.cht-fp__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
  gap: 12px;
}

.cht-fp__heading {
  font-size: var(--fp-heading-desktop);
  font-weight: 800;
  color: var(--fp-title-color);
  letter-spacing: .08em;
  text-transform: uppercase;
  position: relative;
  padding-bottom: 8px;
}

.cht-fp__heading::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 48px;
  height: 3px;
  background: var(--fp-accent);
  border-radius: 2px;
}

.cht-fp__viewall {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 13px;
  font-weight: 700;
  color: var(--fp-viewall-color);
  text-decoration: none;
  white-space: nowrap;
  transition: gap var(--fp-transition), opacity var(--fp-transition);
  flex-shrink: 0;
}

.cht-fp__viewall:hover { opacity: .75; gap: 8px; }

.cht-fp__viewall svg {
  width: 16px;
  height: 16px;
  transition: transform var(--fp-transition);
}

.cht-fp__viewall:hover svg { transform: translateX(3px); }

/* ── Scroll wrapper ── */
.cht-fp__scroll-wrap {
  position: relative;
}

/* ── Grid / Scroll track ── */
.cht-fp__track {
  display: grid;
  list-style: none;
}

#ChtFeaturedProducts-{{ section.id }} .cht-fp__track {
  grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
  gap: {{ section.settings.card_gap }}px;
}

/* ── Card ── */
.cht-fp__card {
  background: var(--fp-card-bg);
  border-radius: var(--fp-card-radius);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  position: relative;
  transition: transform var(--fp-transition), box-shadow var(--fp-transition);
  cursor: pointer;
  box-shadow: 0 16px 40px rgba(0, 0, 0, .05)
}

.cht-fp__card:hover {
  transform: translateY(-4px);
  box-shadow: 0 16px 40px rgba(0,0,0,.13);
}

/* ── Image wrap ── */
.cht-fp__img-wrap {
  position: relative;
  overflow: hidden;
  aspect-ratio: 3 / 4;
  background: #f0f0f0;
  flex-shrink: 0;
}

.cht-fp__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform .45s cubic-bezier(.4,0,.2,1);
}

.cht-fp__card:hover .cht-fp__img {
  transform: scale(1.06);
}

/* ── Badge ── */
.cht-fp__badge {
  position: absolute;
  top: 10px;
  left: 10px;
  background: var(--fp-badge-bg);
  color: var(--fp-badge-color);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .06em;
  text-transform: uppercase;
  padding: 3px 8px;
  border-radius: 4px;
  z-index: 2;
  line-height: 1.4;
}

/* ── Hover overlay + ATC button ── */
.cht-fp__overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,.28);
  opacity: 0;
  transition: opacity var(--fp-transition);
  z-index: 3;
  display: flex;
  align-items: flex-end;
  padding: 14px;
}

.cht-fp__card:hover .cht-fp__overlay {
  opacity: 1;
}

.cht-fp__atc {
  width: 100%;
  padding: 11px 16px;
  background: var(--fp-btn-bg);
  color: var(--fp-btn-color);
  border: none;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 800;
  letter-spacing: .03em;
  text-transform: uppercase;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  transform: translateY(10px);
  transition:
    background var(--fp-transition),
    transform var(--fp-transition),
    opacity var(--fp-transition);
  opacity: 0;
}

.cht-fp__card:hover .cht-fp__atc {
  transform: translateY(0);
  opacity: 1;
}

.cht-fp__atc:hover {
  background: var(--fp-btn-hover-bg);
}

.cht-fp__atc:disabled {
  opacity: .6;
  cursor: not-allowed;
}

.cht-fp__atc svg {
  width: 16px;
  height: 16px;
  flex-shrink: 0;
}

/* ATC loading spinner */
.cht-fp__atc-spinner {
  width: 15px;
  height: 15px;
  border: 2px solid rgba(255,255,255,.35);
  border-top-color: #fff;
  border-radius: 50%;
  animation: cht-fp-spin .65s linear infinite;
  flex-shrink: 0;
}

@keyframes cht-fp-spin {
  to { transform: rotate(360deg); }
}

/* ── Wishlist btn ── */
.cht-fp__wishlist {
  position: absolute;
  top: 10px;
  right: 10px;
  z-index: 4;
  width: 32px;
  height: 32px;
  background: rgba(255,255,255,.9);
  border: none;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  opacity: 0;
  transform: scale(.85);
  transition: opacity var(--fp-transition), transform var(--fp-transition), background var(--fp-transition);
  backdrop-filter: blur(4px);
}

.cht-fp__card:hover .cht-fp__wishlist {
  opacity: 1;
  transform: scale(1);
}

.cht-fp__wishlist:hover { background: #fff; }
.cht-fp__wishlist svg { width: 15px; height: 15px; color: #555; }
.cht-fp__wishlist.is-active svg { color: #e33; fill: #e33; }

/* ── Card body ── */
.cht-fp__body {
  padding: 12px 16px;
  display: flex;
  flex-direction: column;
  gap: 4px;
  flex: 1;
}

.cht-fp__title {
  font-size: var(--fp-title-desktop);
  font-weight: 700;
  color: var(--fp-product-title);
  text-decoration: none;
  display: block;
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  transition: color var(--fp-transition);
}

.cht-fp__title:hover { color: var(--fp-accent); }

.cht-fp__meta {
  font-size: var(--fp-meta-desktop);
  color: var(--fp-meta-color);
  line-height: 1.3;
}

/* ── Price + Rating row ── */
.cht-fp__bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-top: 4px;
  flex-wrap: wrap;
}

.cht-fp__prices {
  display: flex;
  align-items: baseline;
  gap: 6px;
  flex-wrap: wrap;
}

.cht-fp__price {
  font-size: var(--fp-price-desktop);
  font-weight: 800;
  color: var(--fp-price-color);
  line-height: 1;
}

.cht-fp__compare {
  font-size: calc(var(--fp-price-desktop) - 2px);
  color: #aaa;
  text-decoration: line-through;
  font-weight: 500;
}

.cht-fp__rating {
  display: flex;
  align-items: center;
  gap: 3px;
  font-size: var(--fp-meta-desktop);
  font-weight: 700;
  color: var(--fp-meta-color);
  white-space: nowrap;
}

.cht-fp__star {
  color: var(--fp-star-color);
  line-height: 1;
}

/* ── Sold out badge on image ── */
.cht-fp__sold-out {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 5;
}

.cht-fp__sold-out span {
  background: #fff;
  color: #111;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .08em;
  text-transform: uppercase;
  padding: 5px 14px;
  border-radius: 4px;
}

/* ── Toast ── */
.cht-fp-toast {
  position: fixed;
  bottom: 28px;
  left: 50%;
  transform: translateX(-50%) translateY(16px);
  background: #222;
  color: #fff;
  padding: 11px 22px;
  border-radius: 10px;
  font-size: 13.5px;
  font-weight: 600;
  opacity: 0;
  pointer-events: none;
  transition: opacity .3s ease, transform .3s ease;
  z-index: 9999;
  white-space: nowrap;
  display: flex;
  align-items: center;
  gap: 8px;
  box-shadow: 0 8px 24px rgba(0,0,0,.18);
}

.cht-fp-toast.is-visible {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

.cht-fp-toast--success { background: #1d8348; }
.cht-fp-toast--error   { background: #c0392b; }

.cht-fp-toast__icon { font-size: 16px; }

/* ══════════════════════════════════════
   RESPONSIVE
══════════════════════════════════════ */

/* Tablet */
@media (max-width: 1024px) {
  #ChtFeaturedProducts-{{ section.id }} .cht-fp__track {
    grid-template-columns: repeat({{ section.settings.columns_tablet }}, 1fr);
  }
}

/* Mobile */
@media (max-width: 640px) {
  .cht-fp__inner { padding: 0 14px; }

  .cht-fp__heading {
    font-size: var(--fp-heading-mobile);
  }

  #ChtFeaturedProducts-{{ section.id }} .cht-fp__track {
    grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
    gap: {{ section.settings.card_gap | times: 0.7 | round }}px;
  }

  .cht-fp__title  { font-size: var(--fp-title-mobile); }
  .cht-fp__meta   { font-size: var(--fp-meta-mobile); }
  .cht-fp__price  { font-size: var(--fp-price-mobile); }
  .cht-fp__rating { font-size: var(--fp-meta-mobile); }

  .cht-fp__body { padding: 10px; }

  /* On mobile — always show ATC (no hover) */
  .cht-fp__overlay {
    opacity: 1;
    background: linear-gradient(to top, rgba(0,0,0,.55) 0%, transparent 60%);
  }

  .cht-fp__atc {
    opacity: 1;
    transform: translateY(0);
    font-size: 11px;
    padding: 9px 10px;
  }

  .cht-fp__wishlist {
    opacity: 1;
    transform: scale(1);
  }
}

@media (prefers-reduced-motion: reduce) {
  .cht-fp__card,
  .cht-fp__img,
  .cht-fp__overlay,
  .cht-fp__atc,
  .cht-fp__wishlist {
    transition: none !important;
    animation: none !important;
  }
}

{% endstyle %}

{%- liquid
  assign collection_handle = section.settings.collection
  assign collection_obj    = collections[collection_handle]
  assign products_limit    = section.settings.products_limit
  assign show_badge        = section.settings.show_badge
  assign badge_label       = section.settings.badge_label
  assign show_rating       = section.settings.show_rating
  assign show_wishlist     = section.settings.show_wishlist
  assign show_compare      = section.settings.show_compare_price
  assign viewall_label     = section.settings.viewall_label | default: 'View All'
-%}

<section class="cht-fp" id="ChtFeaturedProducts-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="cht-fp__inner">

    {%- comment -%} Section Header {%- endcomment -%}
    <div class="cht-fp__header">
      <h2 class="cht-fp__heading">{{ section.settings.section_title }}</h2>
      {%- if section.settings.show_viewall and collection_obj != blank -%}
        <a href="{{ collection_obj.url }}" class="cht-fp__viewall">
          {{ viewall_label }}
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {%- endif -%}
    </div>

    {%- comment -%} Product Grid {%- endcomment -%}
    {%- if collection_obj != blank and collection_obj.products_count > 0 -%}
      <ul class="cht-fp__track" role="list">
        {%- for product in collection_obj.products limit: products_limit -%}
          {%- liquid
            assign first_variant  = product.first_available_variant
            assign is_sold_out    = false
            if product.available == false
              assign is_sold_out = true
            endif
            assign has_compare = false
            if show_compare and first_variant.compare_at_price > first_variant.price
              assign has_compare = true
            endif
          -%}

          <li class="cht-fp__card"
            data-product-id="{{ product.id }}"
            data-variant-id="{{ first_variant.id }}"
          >
            {%- comment -%} IMAGE AREA {%- endcomment -%}
            <div class="cht-fp__img-wrap">

              {%- comment -%} Badge {%- endcomment -%}
              {%- if show_badge -%}
                {%- if product.tags contains 'popular' or product.tags contains 'Popular' -%}
                  <span class="cht-fp__badge">{{ badge_label | default: 'Popular' }}</span>
                {%- elsif product.tags contains 'new' or product.tags contains 'New' -%}
                  <span class="cht-fp__badge">New</span>
                {%- elsif product.tags contains 'sale' or product.tags contains 'Sale' -%}
                  <span class="cht-fp__badge">Sale</span>
                {%- endif -%}
              {%- endif -%}

              {%- comment -%} Wishlist {%- endcomment -%}
              {%- if show_wishlist -%}
                <button
                  class="cht-fp__wishlist"
                  aria-label="Add {{ product.title | escape }} to wishlist"
                  data-wishlist="{{ product.id }}"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/>
                  </svg>
                </button>
              {%- endif -%}

              {%- comment -%} Product image {%- endcomment -%}
              <a href="{{ product.url }}" tabindex="-1" aria-hidden="true">
                {%- if product.featured_image -%}
                  <img
                    class="cht-fp__img"
                    src="{{ product.featured_image | img_url: '400x533', crop: 'center' }}"
                    alt="{{ product.featured_image.alt | default: product.title | escape }}"
                    loading="lazy"
                    width="400"
                    height="533"
                  >
                {%- else -%}
                  <img
                    class="cht-fp__img"
                    src="{{ 'product-1' | placeholder_svg_tag }}"
                    alt="{{ product.title | escape }}"
                    loading="lazy"
                  >
                {%- endif -%}
              </a>

              {%- comment -%} Sold Out overlay {%- endcomment -%}
              {%- if is_sold_out -%}
                <div class="cht-fp__sold-out"><span>Sold Out</span></div>
              {%- endif -%}

              {%- comment -%} Hover overlay + ATC {%- endcomment -%}
              {%- unless is_sold_out -%}
                <div class="cht-fp__overlay" aria-hidden="true">
                  <button
                    class="cht-fp__atc"
                    data-variant-id="{{ first_variant.id }}"
                    data-product-title="{{ product.title | escape }}"
                    aria-label="Add {{ product.title | escape }} to cart"
                  >
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                      <line x1="3" y1="6" x2="21" y2="6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                      <path d="M16 10a4 4 0 01-8 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <span class="cht-fp__atc-text">Add to Cart</span>
                  </button>
                </div>
              {%- endunless -%}
            </div>

            {%- comment -%} CARD BODY {%- endcomment -%}
            <div class="cht-fp__body">
              <a href="{{ product.url }}" class="cht-fp__title">{{ product.title }}</a>

              {%- unless product.metafields.custom.subtitle == blank -%}
                <span class="cht-fp__meta">{{ product.metafields.custom.subtitle }}</span>
              {%- else -%}
                {%- if product.product_type != blank -%}
                  <span class="cht-fp__meta">{{ product.product_type }}</span>
                {%- elsif product.vendor != blank -%}
                  <span class="cht-fp__meta">{{ product.vendor }}</span>
                {%- endif -%}
              {%- endunless -%}

              <div class="cht-fp__bottom">
                <div class="cht-fp__prices">
                  <span class="cht-fp__price">{{ first_variant.price | money }}</span>
                  {%- if has_compare -%}
                    <span class="cht-fp__compare">{{ first_variant.compare_at_price | money }}</span>
                  {%- endif -%}
                </div>

                {%- if show_rating -%}
                  {%- liquid
                    assign rating_val = product.metafields.reviews.rating.value.rating
                    if rating_val == blank
                      assign rating_val = section.settings.default_rating
                    endif
                  -%}
                  <div class="cht-fp__rating" aria-label="Rating: {{ rating_val }}">
                    <span class="cht-fp__star" aria-hidden="true">★</span>
                    <span>{{ rating_val }}</span>
                  </div>
                {%- endif -%}
              </div>
            </div>

          </li>
        {%- endfor -%}
      </ul>

    {%- else -%}
      {%- comment -%} No products / Empty state {%- endcomment -%}
      <div style="text-align:center;padding:48px 20px;color:#aaa;">
        <p style="font-size:15px;">No products found. Please select a collection in the theme editor.</p>
      </div>
    {%- endif -%}

  </div>
</section>

{%- comment -%} Toast element (shared / created once) {%- endcomment -%}
{%- unless section.settings.toast_rendered -%}
<div class="cht-fp-toast" id="ChtFpToast" role="status" aria-live="polite">
  <span class="cht-fp-toast__icon"></span>
  <span class="cht-fp-toast__msg"></span>
</div>
{%- endunless -%}

<script>
(function () {
  'use strict';

  // ── Toast ──────────────────────────────────────────────
  var toast = document.getElementById('ChtFpToast');

  function showFpToast(msg, type, icon) {
    if (!toast) return;
    toast.querySelector('.cht-fp-toast__msg').textContent  = msg;
    toast.querySelector('.cht-fp-toast__icon').textContent = icon || '';
    toast.className = 'cht-fp-toast cht-fp-toast--' + (type || 'success') + ' is-visible';
    clearTimeout(toast._t);
    toast._t = setTimeout(function () {
      toast.classList.remove('is-visible');
    }, 3200);
  }

  // ── Format money ───────────────────────────────────────
  function formatMoney(cents) {
    if (window.Shopify && window.Shopify.formatMoney) {
      return Shopify.formatMoney(cents, window.theme && window.theme.moneyFormat || '${{amount}}');
    }
    return '$' + (cents / 100).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  }

  // ── Cart drawer integration ────────────────────────────
  function openCartDrawer() {
    // Use the global exposed by cht-header
    if (window.ChtHeader && typeof window.ChtHeader.openCart === 'function') {
      window.ChtHeader.openCart();
    }
  }

  function refreshCartDrawer() {
    if (window.ChtHeader && typeof window.ChtHeader.refreshCart === 'function') {
      window.ChtHeader.refreshCart();
    }
  }

  function updateCartCount(count) {
    var badge = document.getElementById('ChtCartCount');
    if (badge) {
      badge.textContent = count;
      badge.setAttribute('data-count', count);
    }
    var label = document.getElementById('ChtDrawerCount');
    if (label) {
      label.textContent = count + ' item' + (count !== 1 ? 's' : '');
    }
  }

  // ── Add to Cart ────────────────────────────────────────
  function addToCart(variantId, btn, productTitle) {
    if (!variantId) return;

    // Loading state
    var textEl   = btn.querySelector('.cht-fp__atc-text');
    var origText = textEl ? textEl.textContent : 'Add to Cart';
    btn.disabled = true;
    btn.innerHTML =
      '<span class="cht-fp__atc-spinner"></span>' +
      '<span class="cht-fp__atc-text">Adding…</span>';

    fetch('/cart/add.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      },
      body: JSON.stringify({ id: variantId, quantity: 1 })
    })
    .then(function (r) {
      if (!r.ok) return r.json().then(function (d) { throw new Error(d.description || 'Error adding to cart'); });
      return r.json();
    })
    .then(function () {
      // Fetch fresh cart
      return fetch('/cart.js', { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
    })
    .then(function (r) { return r.json(); })
    .then(function (cart) {
      // Update badge
      updateCartCount(cart.item_count);

      // Refresh drawer content
      refreshCartDrawer();

      // Open cart drawer
      openCartDrawer();

      // Success state on button
      btn.innerHTML =
        '<svg viewBox="0 0 20 20" fill="none" width="16" height="16" aria-hidden="true">' +
          '<path d="M4 10l4 4 8-8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>' +
        '</svg>' +
        '<span class="cht-fp__atc-text">Added!</span>';
      btn.style.background = '#1d8348';

      showFpToast('"' + productTitle + '" added to cart', 'success', '🛍');

      // Reset after 2.2s
      setTimeout(function () {
        btn.disabled = false;
        btn.style.background = '';
        btn.innerHTML =
          '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true">' +
            '<path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>' +
            '<line x1="3" y1="6" x2="21" y2="6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>' +
            '<path d="M16 10a4 4 0 01-8 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>' +
          '</svg>' +
          '<span class="cht-fp__atc-text">' + origText + '</span>';
      }, 2200);
    })
    .catch(function (err) {
      console.warn('[CHT FP] ATC error:', err);
      btn.disabled = false;
      btn.innerHTML =
        '<span class="cht-fp__atc-text">' + origText + '</span>';
      showFpToast(err.message || 'Could not add to cart', 'error', '⚠️');
    });
  }

  // ── Event delegation ───────────────────────────────────
  var section = document.getElementById('ChtFeaturedProducts-{{ section.id }}');
  if (!section) return;

  section.addEventListener('click', function (e) {
    // ATC button
    var atcBtn = e.target.closest('.cht-fp__atc');
    if (atcBtn && !atcBtn.disabled) {
      e.preventDefault();
      e.stopPropagation();
      var variantId    = atcBtn.dataset.variantId;
      var productTitle = atcBtn.dataset.productTitle || 'Product';
      addToCart(variantId, atcBtn, productTitle);
      return;
    }

    // Wishlist toggle
    var wishBtn = e.target.closest('.cht-fp__wishlist');
    if (wishBtn) {
      e.preventDefault();
      e.stopPropagation();
      wishBtn.classList.toggle('is-active');
      var isNowActive = wishBtn.classList.contains('is-active');
      showFpToast(
        isNowActive ? 'Added to wishlist' : 'Removed from wishlist',
        isNowActive ? 'success' : 'success',
        isNowActive ? '❤️' : '🤍'
      );
      return;
    }

    // Card click → go to product page
    var card = e.target.closest('.cht-fp__card');
    if (card && !e.target.closest('a') && !e.target.closest('button')) {
      var link = card.querySelector('.cht-fp__title');
      if (link) window.location.href = link.href;
    }
  });

})();
</script>

