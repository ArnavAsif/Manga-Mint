{% comment %}
  CHT MINI — Footer Section
  File: sections/cht-footer.liquid
{% endcomment %}

<style>
@import url('https://fonts.googleapis.com/css2?family=Oswald:wght@700;800&family=Inter:wght@400;500;600;700;800;900&display=swap');

/* ══════════════════════════════════════
   ROOT
══════════════════════════════════════ */
#cht-footer {
  --accent:     {{ section.settings.accent_color }};
  --footer-bg:  {{ section.settings.footer_bg }};
  --text:       {{ section.settings.text_color }};
  --muted:      {{ section.settings.muted_color }};
  --border:     {{ section.settings.border_color }};
  font-family: 'Inter', sans-serif;
  overflow: hidden; /* Prevents horizontal scroll on the whole page */
}

/* ══════════════════════════════════════
   NEWSLETTER BANNER
══════════════════════════════════════ */
.cht-nl {
  position: relative;
  padding: 28px 52px;
  z-index: 10; /* Keeps banner and image above the footer body */
}

/* Background layer for banner to hide the swoosh overflow but allow image to break out */
.cht-nl__bg {
  position: absolute;
  inset: 0;
  background: var(--accent);
  overflow: hidden;
  z-index: 1;
}

/* decorative swoosh */
.cht-nl__bg::before {
  content: '';
  position: absolute;
  right: 340px;
  top: -40px;
  width: 220px;
  height: 220px;
  border-radius: 50%;
  background: rgba(255,255,255,.07);
  pointer-events: none;
}

.cht-nl__inner {
  max-width: 1500px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  gap: 32px;
  position: relative;
  z-index: 2;
}

.cht-nl__text { flex: 0 0 auto; }

.cht-nl__title {
  font-family: 'Oswald', sans-serif;
  font-size: 26px;
  font-weight: 800;
  color: #fff;
  text-transform: uppercase;
  letter-spacing: .05em;
  margin: 0 0 4px;
  line-height: 1.1;
}

.cht-nl__sub {
  font-size: 13px;
  color: rgba(255,255,255,.85);
  margin: 0;
}

.cht-nl__form {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 10px;
  max-width: 520px;
  margin-left: auto;
  margin-right: 280px; /* Leaves empty space on the right for the big character */
}

.cht-nl__input {
  flex: 1;
  height: 48px;
  border: none;
  border-radius: 6px;
  padding: 18px;
  font-size: 14px;
  font-family: 'Inter', sans-serif;
  outline: none;
  background: #fff;
  color: #111;
  box-shadow: 0 2px 12px rgba(0,0,0,.12);
}

.cht-nl__input::placeholder { color: #aaa; }

.cht-nl__btn {
  height: 48px;
  padding: 0 26px;
  background: #111;
  color: #fff;
  border: none;
  border-radius: 6px;
  font-family: 'Oswald', sans-serif;
  font-size: 14px;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
  cursor: pointer;
  white-space: nowrap;
  transition: background .22s, transform .22s cubic-bezier(.34,1.56,.64,1);
}

.cht-nl__btn:hover {
  background: #222;
  transform: translateY(-2px);
}

/* Character Image Overlapping Setup */
.cht-nl__char {
  position: absolute;
  right: 2%;
  top: -100px; /* Pokes out the top of the banner slightly */
  width: 320px; /* Much larger width */
  height: auto;
  object-fit: contain;
  pointer-events: none;
  filter: drop-shadow(-6px 0 18px rgba(0,0,0,.35));
  z-index: 5; /* Ensures it sits on top of everything */
}

/* ══════════════════════════════════════
   MAIN FOOTER BODY
══════════════════════════════════════ */
.cht-footer__body {
  background: var(--footer-bg);
  padding: 48px 52px 28px;
  position: relative;
  z-index: 1; /* Lower than the banner so image overlaps on top */
}

.cht-footer__body-inner {
  max-width: 1500px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 260px repeat(4, 1fr);
  gap: 36px 24px;
  align-items: start;
}

/* ── Brand col ── */
.cht-footer__brand {}

.cht-footer__logo {
  font-family: 'Oswald', sans-serif;
  font-size: 26px;
  font-weight: 800;
  letter-spacing: .04em;
  color: var(--text);
  text-decoration: none;
  display: inline-flex;
  align-items: baseline;
  gap: 3px;
  margin-bottom: 12px;
}

.cht-footer__logo span { color: var(--accent); }

.cht-footer__logo img {
  max-height: 36px;
  width: auto;
  display: block;
}

.cht-footer__tagline {
  font-size: 13px;
  line-height: 1.65;
  color: var(--muted);
  margin: 0 0 20px;
  max-width: 220px;
}

/* socials */
.cht-footer__socials {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.cht-footer__social {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: rgba(0,0,0,.06);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--muted);
  text-decoration: none;
  transition: background .22s, color .22s, transform .22s cubic-bezier(.34,1.56,.64,1);
}

.cht-footer__social:hover {
  background: var(--accent);
  color: #fff;
  transform: translateY(-3px) scale(1.1);
}

.cht-footer__social svg { width: 15px; height: 15px; }

/* ── Nav cols ── */
.cht-footer__col {}

.cht-footer__col-title {
  font-size: 12px;
  font-weight: 800;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--text);
  margin: 0 0 14px;
}

.cht-footer__links {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 9px;
}

.cht-footer__links a {
  font-size: 13px;
  color: var(--muted);
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 5px;
  transition: color .18s, gap .18s;
}

.cht-footer__links a:hover {
  color: var(--accent);
  gap: 8px;
}

/* help col icons */
.cht-footer__contact-item {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  margin-bottom: 12px;
}

.cht-footer__contact-item svg {
  width: 16px;
  height: 16px;
  color: var(--accent);
  flex-shrink: 0;
  margin-top: 1px;
}

.cht-footer__contact-item p {
  margin: 0;
  font-size: 13px;
  color: var(--muted);
  line-height: 1.55;
}

.cht-footer__contact-item a {
  color: var(--muted);
  text-decoration: none;
  transition: color .18s;
}

.cht-footer__contact-item a:hover { color: var(--accent); }

/* ══════════════════════════════════════
   FOOTER BOTTOM BAR
══════════════════════════════════════ */
.cht-footer__bottom {
  background: var(--footer-bg);
  border-top: 1px solid var(--border);
  padding: 16px 52px;
}

.cht-footer__bottom-inner {
  max-width: 1500px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}

.cht-footer__copy {
  font-size: 12.5px;
  color: var(--muted);
  margin: 0;
}

.cht-footer__payments {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.cht-footer__payments img {
  height: 24px;
  width: auto;
  object-fit: contain;
  border-radius: 3px;
  opacity: .85;
  transition: opacity .2s;
}

.cht-footer__payments img:hover { opacity: 1; }

.cht-pay-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 24px;
  padding: 0 8px;
  border-radius: 4px;
  background: #f0f0f0;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .04em;
  color: #444;
  white-space: nowrap;
}

/* ══════════════════════════════════════
   RESPONSIVE
══════════════════════════════════════ */
@media (max-width: 1200px) {
  .cht-nl__form { margin-right: 220px; }
  .cht-nl__char { width: 180px; right: -1%; top: -50px; }
}

@media (max-width: 1100px) {
  .cht-footer__body-inner {
    grid-template-columns: 220px repeat(4, 1fr);
  }
  
}

@media (max-width: 900px) {
  .cht-nl { padding: 24px; }
  
  .cht-nl__form { max-width: 400px; margin-right: 160px; }
  .cht-nl__title { font-size: 20px; }
   .cht-nl__char { display: none; }
  .cht-footer__body { padding: 36px 24px 24px; }
  .cht-footer__body-inner {
    grid-template-columns: 1fr 1fr;
    gap: 28px 20px;
  }
  .cht-footer__brand { grid-column: 1 / -1; }

  .cht-footer__bottom { padding: 14px 24px; }
}

@media (max-width: 768px) {
  .cht-nl__form { margin-right: 120px; }
  .cht-nl__char { display: none; }
}

@media (max-width: 640px) {
  /* newsletter */
  .cht-nl { padding: 22px 18px 22px; }
  .cht-nl__inner { flex-direction: column; align-items: flex-start; gap: 16px; }
  .cht-nl__char  { display: none; } /* Hide on small mobile to avoid text overlapping */
  .cht-nl__form  { width: 100%; max-width: 100%; flex-direction: column; margin-right: 0; }
  .cht-nl__input { width: 100%; }
  .cht-nl__btn   { width: 100%; justify-content: center; }
  .cht-nl__title { font-size: 18px; }

  /* body */
  .cht-footer__body { padding: 28px 18px 20px; }
  .cht-footer__body-inner { grid-template-columns: 1fr 1fr; gap: 24px 16px; }
  .cht-footer__brand { grid-column: 1 / -1; }

  /* bottom */
  .cht-footer__bottom { padding: 14px 18px; }
  .cht-footer__bottom-inner { flex-direction: column; align-items: flex-start; gap: 12px; }
}

@media (max-width: 400px) {
  .cht-footer__body-inner { grid-template-columns: 1fr; }
}
</style>

<footer id="cht-footer">

  <!-- ══ NEWSLETTER BANNER ══ -->
  {%- if section.settings.show_newsletter -%}
  <div class="cht-nl">
    <div class="cht-nl__bg"></div> <!-- Background and swoosh layer -->

    <div class="cht-nl__inner">

      <div class="cht-nl__text">
        <h2 class="cht-nl__title">{{ section.settings.nl_title | default: 'Stay in the Loop!' }}</h2>
        <p class="cht-nl__sub">{{ section.settings.nl_sub | default: 'Subscribe for exclusive deals, new arrivals, and anime updates.' }}</p>
      </div>

      <form class="cht-nl__form" action="/contact#contact_form" method="post" accept-charset="UTF-8">
        <input type="hidden" name="form_type" value="customer">
        <input type="hidden" name="utf8" value="✓">
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input
          class="cht-nl__input"
          type="email"
          name="contact[email]"
          placeholder="{{ section.settings.nl_placeholder | default: 'Enter your email address' }}"
          required
          autocomplete="email"
        >
        <button class="cht-nl__btn" type="submit">
          {{ section.settings.nl_btn | default: 'Subscribe Now' }}
        </button>
      </form>

    </div>

    {%- if section.settings.nl_character != blank -%}
      <img
        src="{{ section.settings.nl_character | img_url: '600x' }}"
        alt="Character"
        class="cht-nl__char"
        loading="lazy"
      >
    {%- endif -%}
  </div>
  {%- endif -%}

  <!-- ══ MAIN BODY ══ -->
  <div class="cht-footer__body">
    <div class="cht-footer__body-inner">

      <!-- Brand -->
      <div class="cht-footer__brand">
        <a href="/" class="cht-footer__logo">
          {%- if section.settings.logo_image != blank -%}
            <img src="{{ section.settings.logo_image | img_url: '200x' }}" alt="{{ shop.name }}">
          {%- else -%}
            <span>{{ section.settings.logo_accent | default: 'CHT' }}</span>{{ section.settings.logo_rest | default: ' MINI' }}
          {%- endif -%}
        </a>
        <p class="cht-footer__tagline">{{ section.settings.tagline | default: 'Your ultimate destination for authentic anime & manga collectibles. 100% original, 100% passion.' }}</p>

        <div class="cht-footer__socials">
          {%- if section.settings.social_facebook != blank -%}
            <a href="{{ section.settings.social_facebook }}" class="cht-footer__social" target="_blank" rel="noopener" aria-label="Facebook">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.social_instagram != blank -%}
            <a href="{{ section.settings.social_instagram }}" class="cht-footer__social" target="_blank" rel="noopener" aria-label="Instagram">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.social_twitter != blank -%}
            <a href="{{ section.settings.social_twitter }}" class="cht-footer__social" target="_blank" rel="noopener" aria-label="X / Twitter">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.social_youtube != blank -%}
            <a href="{{ section.settings.social_youtube }}" class="cht-footer__social" target="_blank" rel="noopener" aria-label="YouTube">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M22.54 6.42a2.78 2.78 0 00-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 00-1.95 1.96A29 29 0 001 12a29 29 0 00.46 5.58A2.78 2.78 0 003.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.4a2.78 2.78 0 001.95-1.96A29 29 0 0023 12a29 29 0 00-.46-5.58zM9.75 15.02V8.98L15.5 12l-5.75 3.02z"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.social_tiktok != blank -%}
            <a href="{{ section.settings.social_tiktok }}" class="cht-footer__social" target="_blank" rel="noopener" aria-label="TikTok">
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.17 8.17 0 004.78 1.52V6.75a4.85 4.85 0 01-1.01-.06z"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      <!-- Col 1: Shop -->
      <div class="cht-footer__col">
        <h3 class="cht-footer__col-title">{{ section.settings.col1_title | default: 'Shop' }}</h3>
        <ul class="cht-footer__links">
          {%- for i in (1..6) -%}
            {%- liquid
              case i
              when 1
                assign lbl = section.settings.col1_link1_label
                assign lnk = section.settings.col1_link1_url
              when 2
                assign lbl = section.settings.col1_link2_label
                assign lnk = section.settings.col1_link2_url
              when 3
                assign lbl = section.settings.col1_link3_label
                assign lnk = section.settings.col1_link3_url
              when 4
                assign lbl = section.settings.col1_link4_label
                assign lnk = section.settings.col1_link4_url
              when 5
                assign lbl = section.settings.col1_link5_label
                assign lnk = section.settings.col1_link5_url
              when 6
                assign lbl = section.settings.col1_link6_label
                assign lnk = section.settings.col1_link6_url
              endcase
            -%}
            {%- if lbl != blank -%}
              <li><a href="{{ lnk | default: '#' }}">{{ lbl }}</a></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      <!-- Col 2: Customer Service -->
      <div class="cht-footer__col">
        <h3 class="cht-footer__col-title">{{ section.settings.col2_title | default: 'Customer Service' }}</h3>
        <ul class="cht-footer__links">
          {%- for i in (1..6) -%}
            {%- liquid
              case i
              when 1
                assign lbl = section.settings.col2_link1_label
                assign lnk = section.settings.col2_link1_url
              when 2
                assign lbl = section.settings.col2_link2_label
                assign lnk = section.settings.col2_link2_url
              when 3
                assign lbl = section.settings.col2_link3_label
                assign lnk = section.settings.col2_link3_url
              when 4
                assign lbl = section.settings.col2_link4_label
                assign lnk = section.settings.col2_link4_url
              when 5
                assign lbl = section.settings.col2_link5_label
                assign lnk = section.settings.col2_link5_url
              when 6
                assign lbl = section.settings.col2_link6_label
                assign lnk = section.settings.col2_link6_url
              endcase
            -%}
            {%- if lbl != blank -%}
              <li><a href="{{ lnk | default: '#' }}">{{ lbl }}</a></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      <!-- Col 3: Company -->
      <div class="cht-footer__col">
        <h3 class="cht-footer__col-title">{{ section.settings.col3_title | default: 'Company' }}</h3>
        <ul class="cht-footer__links">
          {%- for i in (1..6) -%}
            {%- liquid
              case i
              when 1
                assign lbl = section.settings.col3_link1_label
                assign lnk = section.settings.col3_link1_url
              when 2
                assign lbl = section.settings.col3_link2_label
                assign lnk = section.settings.col3_link2_url
              when 3
                assign lbl = section.settings.col3_link3_label
                assign lnk = section.settings.col3_link3_url
              when 4
                assign lbl = section.settings.col3_link4_label
                assign lnk = section.settings.col3_link4_url
              when 5
                assign lbl = section.settings.col3_link5_label
                assign lnk = section.settings.col3_link5_url
              when 6
                assign lbl = section.settings.col3_link6_label
                assign lnk = section.settings.col3_link6_url
              endcase
            -%}
            {%- if lbl != blank -%}
              <li><a href="{{ lnk | default: '#' }}">{{ lbl }}</a></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      <!-- Col 4: Help & Support -->
      <div class="cht-footer__col">
        <h3 class="cht-footer__col-title">{{ section.settings.col4_title | default: 'Help & Support' }}</h3>

        {%- if section.settings.contact_email != blank -%}
          <div class="cht-footer__contact-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><polyline points="2,4 12,13 22,4"/></svg>
            <p><a href="mailto:{{ section.settings.contact_email }}">{{ section.settings.contact_email }}</a></p>
          </div>
        {%- endif -%}

        {%- if section.settings.contact_phone != blank -%}
          <div class="cht-footer__contact-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.85 11.5 19.79 19.79 0 01.78 2.82 2 2 0 012.78 1h3a2 2 0 012 1.72c.13.96.36 1.9.7 2.81a2 2 0 01-.45 2.11L6.91 8.76a16 16 0 006.29 6.29l1.12-1.12a2 2 0 012.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0122 16.92z"/></svg>
            <p><a href="tel:{{ section.settings.contact_phone }}">{{ section.settings.contact_phone }}</a></p>
          </div>
        {%- endif -%}

        {%- if section.settings.contact_hours != blank -%}
          <div class="cht-footer__contact-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12,6 12,12 16,14"/></svg>
            <p>{{ section.settings.contact_hours }}</p>
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>

  <!-- ══ BOTTOM BAR ══ -->
  <div class="cht-footer__bottom">
    <div class="cht-footer__bottom-inner">
      <p class="cht-footer__copy">{{ section.settings.copyright | default: '© 2024 CHT Mini. All Rights Reserved.' }}</p>

      <div class="cht-footer__payments">
        {%- if section.settings.pay_visa -%}
          <span class="cht-pay-badge" style="background:#1a1f71;color:#fff;">VISA</span>
        {%- endif -%}
        {%- if section.settings.pay_mastercard -%}
          <span class="cht-pay-badge" style="background:#eb001b;color:#fff;">MC</span>
        {%- endif -%}
        {%- if section.settings.pay_amex -%}
          <span class="cht-pay-badge" style="background:#007bc1;color:#fff;">AMEX</span>
        {%- endif -%}
        {%- if section.settings.pay_paypal -%}
          <span class="cht-pay-badge" style="background:#003087;color:#fff;">PayPal</span>
        {%- endif -%}
        {%- if section.settings.pay_gpay -%}
          <span class="cht-pay-badge" style="background:#fff;color:#111;border:1px solid #ddd;">G Pay</span>
        {%- endif -%}
        {%- if section.settings.pay_applepay -%}
          <span class="cht-pay-badge" style="background:#000;color:#fff;">Apple Pay</span>
        {%- endif -%}
      </div>
    </div>
  </div>

</footer>

{% schema %}
{
  "name": "CHT Footer",
  "settings": [
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#E84C00"
    },
    {
      "type": "color",
      "id": "footer_bg",
      "label": "Footer background",
      "default": "#ffffff"
    },
