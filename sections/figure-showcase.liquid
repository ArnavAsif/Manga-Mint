{% comment %}
  CHT MINI — Anime Figure Showcase Section
  File: sections/cht-figure-showcase.liquid
{% endcomment %}

{% style %}
/* ============================================================
   CHT Figure Showcase — Styles
   ============================================================ */

.cht-fig *,
.cht-fig *::before,
.cht-fig *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

.cht-fig {
  --fig-accent:        {{ section.settings.accent_color }};
  --fig-bg:            {{ section.settings.section_bg }};
  --fig-card-bg:       {{ section.settings.card_bg }};
  --fig-card-radius:   {{ section.settings.card_radius }}px;
  --fig-card-border:   {{ section.settings.card_border_color }};
  --fig-heading-color: {{ section.settings.heading_color }};
  --fig-title-color:   {{ section.settings.title_color }};
  --fig-price-color:   {{ section.settings.price_color }};
  --fig-viewall-color: {{ section.settings.viewall_color }};
  --fig-btn-bg:        {{ section.settings.btn_bg }};
  --fig-btn-color:     {{ section.settings.btn_icon_color }};
  --fig-btn-hover:     {{ section.settings.btn_hover_bg }};
  --fig-heading-desk:  {{ section.settings.heading_size_desktop }}px;
  --fig-heading-mob:   {{ section.settings.heading_size_mobile }}px;
  --fig-title-desk:    {{ section.settings.title_size_desktop }}px;
  --fig-title-mob:     {{ section.settings.title_size_mobile }}px;
  --fig-price-desk:    {{ section.settings.price_size_desktop }}px;
  --fig-price-mob:     {{ section.settings.price_size_mobile }}px;
  --fig-transition:    .25s cubic-bezier(.4,0,.2,1);

  background: var(--fig-bg);
  padding: {{ section.settings.pad_top }}px 0 {{ section.settings.pad_bottom }}px;
  width: 100%;
}

/* ── Inner ── */
.cht-fig__inner {
  max-width: 1440px;
  margin: 0 auto;
  padding: 0 24px;
}

/* ── Header ── */
.cht-fig__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
  gap: 12px;
}

.cht-fig__heading {
  font-size: var(--fig-heading-desk);
  font-weight: 900;
  color: var(--fig-heading-color);
  text-transform: uppercase;
  letter-spacing: .04em;
  line-height: 1.1;
}

.cht-fig__viewall {
  display: flex;
  align-items: center;
  gap: 4px;
  font-size: 13px;
  font-weight: 700;
  color: var(--fig-viewall-color);
  text-decoration: none;
  white-space: nowrap;
  flex-shrink: 0;
  transition: gap var(--fig-transition), opacity var(--fig-transition);
}

.cht-fig__viewall:hover { opacity: .75; gap: 7px; }

.cht-fig__viewall svg {
  width: 14px;
  height: 14px;
  transition: transform var(--fig-transition);
}

.cht-fig__viewall:hover svg { transform: translateX(3px); }

/* ── Scroll track (horizontal scroll on mobile) ── */
.cht-fig__scroll {
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  padding-bottom: 4px;
}

.cht-fig__scroll::-webkit-scrollbar { display: none; }

/* ── Grid ── */
.cht-fig__grid {
  display: grid;
  grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
  gap: {{ section.settings.card_gap }}px;
  list-style: none;
  min-width: 0;
}

/* ── Card ── */
.cht-fig__card {
  background: var(--fig-card-bg);
  border-radius: var(--fig-card-radius);
  border: 1px solid var(--fig-card-border);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  position: relative;
  transition: transform var(--fig-transition), box-shadow var(--fig-transition);
  min-width: 0;
}

.cht-fig__card:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 32px rgba(0,0,0,.1);
}

/* ── Image area ── */
.cht-fig__img-wrap {
  position: relative;
  background: {{ section.settings.img_bg }};
  overflow: hidden;
  aspect-ratio: {{ section.settings.img_aspect }};
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.cht-fig__img {
  width: 100%;
  height: 100%;
  object-fit: {{ section.settings.img_fit }};
  object-position: center bottom;
  display: block;
  transition: transform .45s cubic-bezier(.4,0,.2,1);
}

.cht-fig__card:hover .cht-fig__img {
  transform: scale(1.05) translateY(-4px);
}

/* ── Card footer ── */
.cht-fig__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 10px 12px;
  border-top: 1px solid var(--fig-card-border);
  background: var(--fig-card-bg);
}

.cht-fig__info {
  flex: 1;
  min-width: 0;
}

.cht-fig__title {
  display: block;
  font-size: var(--fig-title-desk);
  font-weight: 700;
  color: var(--fig-title-color);
  text-decoration: none;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.3;
  margin-bottom: 2px;
  transition: color var(--fig-transition);
}

.cht-fig__title:hover { color: var(--fig-accent); }

.cht-fig__price {
  display: block;
  font-size: var(--fig-price-desk);
  font-weight: 800;
  color: var(--fig-price-color);
  line-height: 1;
}

.cht-fig__compare {
  font-size: calc(var(--fig-price-desk) - 1px);
  color: #aaa;
  text-decoration: line-through;
  font-weight: 400;
  margin-left: 4px;
}

/* ── ATC icon button ── */
.cht-fig__atc {
  flex-shrink: 0;
  width: 34px;
  height: 34px;
  background: var(--fig-btn-bg);
  color: var(--fig-btn-color);
  border: none;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: background var(--fig-transition), transform var(--fig-transition);
  position: relative;
}

.cht-fig__atc:hover {
  background: var(--fig-btn-hover);
  transform: scale(1.08);
}

.cht-fig__atc:disabled {
  opacity: .5;
  cursor: not-allowed;
  transform: none;
}

.cht-fig__atc svg {
  width: 17px;
  height: 17px;
  flex-shrink: 0;
}

/* ATC spinner */
.cht-fig__spinner {
  width: 14px;
  height: 14px;
  border: 2px solid rgba(255,255,255,.35);
  border-top-color: #fff;
  border-radius: 50%;
  animation: cht-fig-spin .6s linear infinite;
}

@keyframes cht-fig-spin { to { transform: rotate(360deg); } }

/* ── Sold out badge ── */
.cht-fig__sold-out {
  position: absolute;
  top: 8px;
  left: 8px;
  background: #333;
  color: #fff;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .08em;
  text-transform: uppercase;
  padding: 3px 7px;
  border-radius: 4px;
  z-index: 2;
}

/* ── Badge ── */
.cht-fig__badge {
  position: absolute;
  top: 8px;
  right: 8px;
  background: var(--fig-accent);
  color: #fff;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .06em;
  text-transform: uppercase;
  padding: 3px 7px;
  border-radius: 4px;
  z-index: 2;
}

/* ── Toast ── */
.cht-fig-toast {
  position: fixed;
  bottom: 28px;
  left: 50%;
  transform: translateX(-50%) translateY(16px);
  background: #222;
  color: #fff;
  padding: 11px 20px;
  border-radius: 10px;
  font-size: 13px;
  font-weight: 600;
  opacity: 0;
  pointer-events: none;
  transition: opacity .3s ease, transform .3s ease;
  z-index: 9999;
  white-space: nowrap;
  display: flex;
  align-items: center;
  gap: 8px;
  box-shadow: 0 8px 24px rgba(0,0,0,.2);
}

.cht-fig-toast.is-visible {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

.cht-fig-toast--success { background: #1d8348; }
.cht-fig-toast--error   { background: #c0392b; }

/* ══════════════════════════════════════
   RESPONSIVE
══════════════════════════════════════ */
@media (max-width: 1100px) {
  .cht-fig__grid {
    grid-template-columns: repeat({{ section.settings.columns_tablet }}, 1fr);
  }
}

@media (max-width: 768px) {
  .cht-fig__inner { padding: 0 16px; }

  .cht-fig__heading { font-size: var(--fig-heading-mob); }

  /* Horizontal scroll on mobile */
  .cht-fig__scroll {
    margin: 0 -16px;
    padding: 0 16px 8px;
  }

  .cht-fig__grid {
    grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(140px, 1fr));
    gap: 10px;
    /* allow horizontal scroll */
    width: max-content;
    min-width: 100%;
  }

  .cht-fig__title  { font-size: var(--fig-title-mob); }
  .cht-fig__price  { font-size: var(--fig-price-mob); }

  .cht-fig__footer { padding: 8px 10px; }

  .cht-fig__atc {
    width: 30px;
    height: 30px;
    border-radius: 6px;
  }

  .cht-fig__atc svg { width: 15px; height: 15px; }
}

@media (max-width: 480px) {
  .cht-fig__inner { padding: 0 12px; }

  .cht-fig__scroll {
    margin: 0 -12px;
    padding: 0 12px 8px;
  }

  .cht-fig__grid {
    grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(130px, 1fr));
    gap: 8px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .cht-fig__img,
  .cht-fig__card { transition: none !important; }
  .cht-fig__spinner { animation: none !important; }
}
{% endstyle %}

{%- liquid
  assign collection_obj = collections[section.settings.collection]
  assign products_limit = section.settings.products_limit
  assign show_badge     = section.settings.show_badge
  assign show_compare   = section.settings.show_compare
  assign viewall_label  = section.settings.viewall_label | default: 'View All Figures'
-%}

<section class="cht-fig" id="ChtFigShowcase-{{ section.id }}" data-section-id="{{ section.id }}">
  <div class="cht-fig__inner">

    {%- comment -%} Header {%- endcomment -%}
    <div class="cht-fig__header">
      <h2 class="cht-fig__heading">{{ section.settings.section_title }}</h2>
      {%- if section.settings.show_viewall and collection_obj != blank -%}
        <a href="{{ collection_obj.url }}" class="cht-fig__viewall">
          {{ viewall_label }}
          <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {%- endif -%}
    </div>

    {%- comment -%} Product Grid {%- endcomment -%}
    {%- if collection_obj != blank and collection_obj.products_count > 0 -%}
      <div class="cht-fig__scroll">
        <ul class="cht-fig__grid" role="list">
          {%- for product in collection_obj.products limit: products_limit -%}
            {%- liquid
              assign first_variant = product.first_available_variant
              assign is_sold_out   = false
              if product.available == false
                assign is_sold_out = true
              endif
              assign has_compare = false
              if show_compare and first_variant.compare_at_price > first_variant.price
                assign has_compare = true
              endif
            -%}

            <li class="cht-fig__card" data-variant-id="{{ first_variant.id }}">

              {%- comment -%} Image area {%- endcomment -%}
              <a href="{{ product.url }}" class="cht-fig__img-wrap" tabindex="0">
                {%- if is_sold_out -%}
                  <span class="cht-fig__sold-out">Sold Out</span>
                {%- endif -%}

                {%- if show_badge -%}
                  {%- if product.tags contains 'new' or product.tags contains 'New' -%}
                    <span class="cht-fig__badge">New</span>
                  {%- elsif product.tags contains 'sale' or product.tags contains 'Sale' -%}
                    <span class="cht-fig__badge">Sale</span>
                  {%- elsif product.tags contains 'hot' or product.tags contains 'Hot' -%}
                    <span class="cht-fig__badge">Hot</span>
                  {%- endif -%}
                {%- endif -%}

                {%- if product.featured_image -%}
                  <img
                    class="cht-fig__img"
                    src="{{ product.featured_image | img_url: '400x500', crop: 'bottom' }}"
                    alt="{{ product.featured_image.alt | default: product.title | escape }}"
                    loading="lazy"
                    width="400"
                    height="500"
                  >
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'cht-fig__img' }}
                {%- endif -%}
              </a>

              {%- comment -%} Footer: title + price + ATC {%- endcomment -%}
              <div class="cht-fig__footer">
                <div class="cht-fig__info">
                  <a href="{{ product.url }}" class="cht-fig__title">{{ product.title }}</a>
                  <span class="cht-fig__price">
                    {{ first_variant.price | money }}
                    {%- if has_compare -%}
                      <span class="cht-fig__compare">{{ first_variant.compare_at_price | money }}</span>
                    {%- endif -%}
                  </span>
                </div>

                {%- unless is_sold_out -%}
                  <button
                    class="cht-fig__atc"
                    data-variant-id="{{ first_variant.id }}"
                    data-product-title="{{ product.title | escape }}"
                    aria-label="Add {{ product.title | escape }} to cart"
                  >
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      <line x1="3" y1="6" x2="21" y2="6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                      <path d="M16 10a4 4 0 01-8 0" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                {%- else -%}
                  <button class="cht-fig__atc" disabled aria-label="Sold out">
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      <line x1="3" y1="6" x2="21" y2="6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                      <path d="M16 10a4 4 0 01-8 0" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                {%- endunless -%}
              </div>

            </li>
          {%- endfor -%}
        </ul>
      </div>

    {%- else -%}
      <div style="text-align:center;padding:40px 20px;color:#aaa;">
        <p style="font-size:14px;">Select a collection in the theme editor to display figures.</p>
      </div>
    {%- endif -%}

  </div>
</section>

{%- comment -%} Toast {%- endcomment -%}
<div class="cht-fig-toast" id="ChtFigToast" role="status" aria-live="polite">
  <span class="cht-fig-toast__icon"></span>
  <span class="cht-fig-toast__msg"></span>
</div>

<script>
(function () {
  'use strict';

  var sectionEl = document.getElementById('ChtFigShowcase-{{ section.id }}');
  var toast     = document.getElementById('ChtFigToast');
  if (!sectionEl) return;

  /* ── Toast ── */
  function showToast(msg, type, icon) {
    if (!toast) return;
    toast.querySelector('.cht-fig-toast__msg').textContent  = msg;
    toast.querySelector('.cht-fig-toast__icon').textContent = icon || '';
    toast.className = 'cht-fig-toast cht-fig-toast--' + (type || 'success') + ' is-visible';
    clearTimeout(toast._t);
    toast._t = setTimeout(function () { toast.classList.remove('is-visible'); }, 3000);
  }

  /* ── Format money ── */
  function formatMoney(cents) {
    if (window.Shopify && window.Shopify.formatMoney) {
      return Shopify.formatMoney(cents, '${{amount}}');
    }
    return '$' + (cents / 100).toFixed(2);
  }

  /* ── Update cart badge ── */
  function updateCartBadge(count) {
    var badge = document.getElementById('ChtCartCount');
    if (badge) {
      badge.textContent = count;
      badge.setAttribute('data-count', count);
    }
    var label = document.getElementById('ChtDrawerCount');
    if (label) {
      label.textContent = count + ' item' + (count !== 1 ? 's' : '');
    }
  }

  /* ── Add to Cart ── */
  function addToCart(variantId, btn, productTitle) {
    if (!variantId || btn.disabled) return;

    /* Loading state */
    btn.disabled = true;
    var origHTML = btn.innerHTML;
    btn.innerHTML = '<span class="cht-fig__spinner"></span>';

    fetch('/cart/add.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      },
      body: JSON.stringify({ id: variantId, quantity: 1 })
    })
    .then(function (r) {
      if (!r.ok) return r.json().then(function (d) { throw new Error(d.description || 'Error'); });
      return r.json();
    })
    .then(function () {
      return fetch('/cart.js', { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
    })
    .then(function (r) { return r.json(); })
    .then(function (cart) {
      /* Update badge */
      updateCartBadge(cart.item_count);

      /* Refresh + open drawer */
      if (window.ChtHeader) {
        if (typeof window.ChtHeader.refreshCart === 'function') {
          window.ChtHeader.refreshCart();
        }
        if (typeof window.ChtHeader.openCart === 'function') {
          window.ChtHeader.openCart();
        }
      }

      /* Success state */
      btn.innerHTML =
        '<svg viewBox="0 0 20 20" fill="none" width="16" height="16">' +
          '<path d="M4 10l4 4 8-8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>' +
        '</svg>';
      btn.style.background = '#1d8348';

      showToast('"' + productTitle + '" added to cart', 'success', '🛍');

      /* Reset after 2s */
      setTimeout(function () {
        btn.disabled      = false;
        btn.innerHTML     = origHTML;
        btn.style.background = '';
      }, 2000);
    })
    .catch(function (err) {
      console.warn('[CHT Fig] ATC error:', err);
      btn.disabled      = false;
      btn.innerHTML     = origHTML;
      btn.style.background = '';
      showToast(err.message || 'Could not add to cart', 'error', '⚠️');
    });
  }

  /* ── Event delegation ── */
  sectionEl.addEventListener('click', function (e) {
    var atcBtn = e.target.closest('.cht-fig__atc');
    if (atcBtn && !atcBtn.disabled) {
      e.preventDefault();
      e.stopPropagation();
      var variantId    = atcBtn.dataset.variantId;
      var productTitle = atcBtn.dataset.productTitle || 'Product';
      addToCart(variantId, atcBtn, productTitle);
    }
  });

})();
</script>

{% schema %}
{
  "name": "CHT Figure Showcase",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section"
    },
    {
      "type": "text",
      "id": "section_title",
      "label": "Section heading",
      "default": "Anime Figure Showcase"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "show_viewall",
      "label": "Show View All link",
      "default": true
    },
    {
      "type": "text",
      "id": "viewall_label",
      "label": "View All label",
      "default": "View All Figures"
    },
    {
      "type": "header",
      "content": "Grid Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns — Desktop",
      "min": 3,
      "max": 8,
      "step": 1,
      "default": 6
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Columns — Tablet",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Cards visible — Mobile scroll",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap between cards",
      "min": 4,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Card Image"
    },
    {
      "type": "select",
      "id": "img_aspect",
      "label": "Image aspect ratio",
      "options": [
        { "value": "3/4",  "label": "3:4 (Portrait)" },
        { "value": "1/1",  "label": "1:1 (Square)" },
        { "value": "4/5",  "label": "4:5" },
        { "value": "2/3",  "label": "2:3 (Tall)" }
      ],
      "default": "3/4"
    },
    {
      "type": "select",
      "id": "img_fit",
      "label": "Image fit",
      "options": [
        { "value": "contain", "label": "Contain (show full figure)" },
        { "value": "cover",   "label": "Cover (fill frame)" }
      ],
      "default": "contain"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card border radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Features"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show product badge",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_compare",
      "label": "Show compare-at price",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Padding top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Font Sizes — Desktop"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Section heading",
      "min": 14,
      "max": 40,
